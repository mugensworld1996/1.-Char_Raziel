;==============================================================================
; STAND
; Override de State 0 de common1.cns
;==============================================================================

[Statedef 0]
type = S
physics = S
sprpriority = 0


;------------------------------------------------------------------------------
; ANIMACION DE STAND
;------------------------------------------------------------------------------


; Con espada fisica
;==============================================================================
; GIRO CON ESPADA
;==============================================================================

[State 0, Sword Turn]
type = ChangeAnim
triggerall = var(20) = 0

; Cuando MUGEN intenta usar su giro normal Action 5,
; sustituimos esa animacion por nuestro giro con espada.
trigger1 = Anim = 5

value = 8


;==============================================================================
; STAND CON ESPADA
;==============================================================================

[State 0, Stand Sword]
type = ChangeAnim
triggerall = var(20) = 0

; Stand normal
; No interrumpir Action 5 ni nuestro Action 8
trigger1 = Anim != 1000 && Anim != 5 && Anim != 8

; Si termina el giro normal
trigger2 = Anim = 5 && AnimTime = 0

; Si termina nuestro giro con espada
trigger3 = Anim = 8 && AnimTime = 0

value = 1000


; Sin espada
[State 0, Stand Unarmed]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0


;------------------------------------------------------------------------------
; LOGICA ORIGINAL DE COMMON1
;------------------------------------------------------------------------------


[State 0, Reset Y Velocity]
type = VelSet
trigger1 = Time = 0
y = 0


[State 0, Stop Moving]
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0


[State 0, Dead]
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

;==============================================================================
; CROUCH START
; State 10
; Parado -> Agachado
;==============================================================================

[Statedef 10]
type = C
movetype = I
physics = C
ctrl = 0
sprpriority = 0


;------------------------------------------------------------------------------
; ANIMACION CON ESPADA
;------------------------------------------------------------------------------

[State 10, Sword Crouch Start]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Time = 0
value = 1020


;------------------------------------------------------------------------------
; ANIMACION SIN ESPADA
;------------------------------------------------------------------------------

[State 10, Unarmed Crouch Start]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Time = 0
value = 10


;------------------------------------------------------------------------------
; LOGICA ORIGINAL
; Reducir velocidad horizontal al empezar a agacharse
;------------------------------------------------------------------------------

[State 10, Crouch Friction]
type = VelMul
trigger1 = Time = 0
x = 0.75


;------------------------------------------------------------------------------
; TERMINAR TRANSICION
;------------------------------------------------------------------------------

[State 10, To Crouch]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;==============================================================================
; CROUCH
; State 11
; Raziel permanece agachado
;==============================================================================

[Statedef 11]
type = C
movetype = I
physics = C
ctrl = 1
sprpriority = 0


;------------------------------------------------------------------------------
; AGACHADO CON ESPADA
;------------------------------------------------------------------------------

[State 11, Sword Crouch]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Anim != 1025
value = 1025


;------------------------------------------------------------------------------
; AGACHADO SIN ESPADA
;------------------------------------------------------------------------------

[State 11, Unarmed Crouch]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Anim != 11
value = 11


;------------------------------------------------------------------------------
; SOLTAR ABAJO -> LEVANTARSE
;------------------------------------------------------------------------------

[State 11, Crouch End]
type = ChangeState
trigger1 = command != "holddown"
value = 12

;==============================================================================
; CROUCH END
; State 12
; Agachado -> Parado
;==============================================================================

[Statedef 12]
type = S
movetype = I
physics = S
ctrl = 0
sprpriority = 0


;------------------------------------------------------------------------------
; LEVANTARSE CON ESPADA
;------------------------------------------------------------------------------

[State 12, Sword Crouch End]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Time = 0
value = 1021


;------------------------------------------------------------------------------
; LEVANTARSE SIN ESPADA
;------------------------------------------------------------------------------

[State 12, Unarmed Crouch End]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Time = 0
value = 12


;------------------------------------------------------------------------------
; VOLVER A STAND
;------------------------------------------------------------------------------

[State 12, To Stand]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;==============================================================================
; WALK
; Override de State 20 de common1.cns
;==============================================================================

[Statedef 20]
type = S
movetype = I
physics = S
ctrl = 1
sprpriority = 0


;------------------------------------------------------------------------------
; VELOCIDAD
;------------------------------------------------------------------------------


; Caminar hacia adelante
[State 20, Walk Forward Velocity]
type = VelSet
trigger1 = command = "holdfwd"
x = Const(velocity.walk.fwd.x)


; Caminar hacia atras
[State 20, Walk Back Velocity]
type = VelSet
trigger1 = command = "holdback"
x = Const(velocity.walk.back.x)



;==============================================================================
; ANIMACIONES CON ESPADA
; var(20) = 0
;==============================================================================

;==============================================================================
; GIRO CON ESPADA DURANTE CAMINATA
;==============================================================================

[State 20, Sword Turn]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Anim = 5
value = 8


;------------------------------------------------------------------------------
; Adelante con espada
;------------------------------------------------------------------------------

[State 20, Sword Walk Forward]
type = ChangeAnim

triggerall = var(20) = 0
triggerall = command = "holdfwd"

; No interrumpir el giro
trigger1 = Anim != 1010 && Anim != 5 && Anim != 8

; Cuando termine Action 8, volver a caminar
trigger2 = Anim = 8 && AnimTime = 0

value = 1010


;------------------------------------------------------------------------------
; Atras con espada
;------------------------------------------------------------------------------

[State 20, Sword Walk Back]
type = ChangeAnim

triggerall = var(20) = 0
triggerall = command = "holdback"

; No interrumpir el giro
trigger1 = Anim != 1015 && Anim != 5 && Anim != 8

; Cuando termine Action 8, volver a caminar atras
trigger2 = Anim = 8 && AnimTime = 0

value = 1015



;==============================================================================
; ANIMACIONES SIN ESPADA
; var(20) != 0
;==============================================================================


;------------------------------------------------------------------------------
; Adelante sin espada
;------------------------------------------------------------------------------

[State 20, Unarmed Walk Forward]
type = ChangeAnim

triggerall = var(20) != 0
triggerall = command = "holdfwd"

trigger1 = Anim != 20

value = 20


;------------------------------------------------------------------------------
; Atras sin espada
;------------------------------------------------------------------------------

[State 20, Unarmed Walk Back]
type = ChangeAnim

triggerall = var(20) != 0
triggerall = command = "holdback"

trigger1 = Anim != 21

value = 21



;==============================================================================
; TERMINAR CAMINATA
;==============================================================================

[State 20, End Walk]
type = ChangeState

triggerall = command != "holdfwd"
triggerall = command != "holdback"

trigger1 = 1

value = 0
ctrl = 1


;==============================================================================
; JUMP START
; State 40
;==============================================================================
;
; CON ESPADA:
;   Action 1030
;
; SIN ESPADA:
;   Action 40
;
;==============================================================================

[Statedef 40]
type = S
physics = S
ctrl = 0
sprpriority = 1
facep2 = 1


;------------------------------------------------------------------------------
; ANIMACION DE INICIO
;------------------------------------------------------------------------------

[State 40, Sword Jump Start]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Time = 0
value = 1030


[State 40, Reaver Jump Start]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Time = 0
value = 40


;------------------------------------------------------------------------------
; DIRECCION DEL SALTO
;------------------------------------------------------------------------------

[State 40, Reset Jump Direction]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0


[State 40, Jump Forward]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1


[State 40, Jump Back]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1


;------------------------------------------------------------------------------
; VELOCIDAD DEL SALTO
;------------------------------------------------------------------------------

[State 40, Jump Velocity]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)


;------------------------------------------------------------------------------
; SALTO DESDE CARRERA
;------------------------------------------------------------------------------

[State 40, Running Jump]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = PrevStateNo = 100
trigger1 = sysvar(1) = 1
x = Const(velocity.runjump.fwd.x)


;------------------------------------------------------------------------------
; PASAR AL ESTADO AEREO
;------------------------------------------------------------------------------

[State 40, To Jump]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1



;==============================================================================
; JUMP
; State 50
;==============================================================================
;
; ASCENSO:
;
;   SIN ESPADA       CON ESPADA
;   41 arriba        1031 arriba
;   42 adelante      1032 adelante
;   43 atras         1033 atras
;
; CAIDA:
;
;   SIN ESPADA       CON ESPADA
;   44 arriba        1034 arriba
;   45 adelante      1035 adelante
;   46 atras         1036 atras
;
;==============================================================================

[Statedef 50]
type = A
physics = A


;------------------------------------------------------------------------------
; RESET
;------------------------------------------------------------------------------

[State 50, Reset]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0


;==============================================================================
; ASCENSO CON ESPADA
;==============================================================================

[State 50, Sword Jump]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Time = 0
value = ifelse((vel x)=0,1031,ifelse((vel x)>0,1032,1033))


;==============================================================================
; ASCENSO SIN ESPADA
;==============================================================================

[State 50, Reaver Jump]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Time = 0
value = ifelse((vel x)=0,41,ifelse((vel x)>0,42,43))


;==============================================================================
; ASCENSO -> CAIDA CON ESPADA
;==============================================================================

[State 50, Sword Falling]
type = ChangeAnim

triggerall = var(20) = 0
triggerall = Anim >= 1031
triggerall = Anim <= 1033

trigger1 = Vel Y > Const720p(-8)

persistent = 0

value = Anim + 3


;==============================================================================
; ASCENSO -> CAIDA SIN ESPADA
;==============================================================================

[State 50, Reaver Falling]
type = ChangeAnim

triggerall = var(20) != 0
triggerall = Anim >= 41
triggerall = Anim <= 43

trigger1 = Vel Y > Const720p(-8)

persistent = 0

value = Anim + 3



;==============================================================================
; JUMP LAND
; State 52
;==============================================================================
;
; CON ESPADA:
;   Action 1037
;
; SIN ESPADA:
;   Action 47
;
;==============================================================================

[Statedef 52]
type = S
physics = S
ctrl = 0


;------------------------------------------------------------------------------
; ANIMACION DE ATERRIZAJE
;------------------------------------------------------------------------------

[State 52, Sword Landing]
type = ChangeAnim
triggerall = var(20) = 0
trigger1 = Time = 0
value = 1037


[State 52, Reaver Landing]
type = ChangeAnim
triggerall = var(20) != 0
trigger1 = Time = 0
value = 47


;------------------------------------------------------------------------------
; CORREGIR VELOCIDAD VERTICAL
;------------------------------------------------------------------------------

[State 52, Stop Y]
type = VelSet
trigger1 = Time = 0
y = 0


;------------------------------------------------------------------------------
; COLOCAR A RAZIEL SOBRE EL SUELO
;------------------------------------------------------------------------------

[State 52, Ground Position]
type = PosSet
trigger1 = Time = 0
y = 0


;------------------------------------------------------------------------------
; DEVOLVER CONTROL
;------------------------------------------------------------------------------

[State 52, Control]
type = CtrlSet
trigger1 = Time = 3
value = 1


;------------------------------------------------------------------------------
; DETENER MOVIMIENTO HORIZONTAL
;------------------------------------------------------------------------------

[State 52, Stop Moving]
type = VelSet
trigger1 = abs(Vel X) < Const(movement.stand.friction.threshold)
x = 0


;------------------------------------------------------------------------------
; VOLVER A STAND
;------------------------------------------------------------------------------

[State 52, End Landing]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Throw - Attempt
; CNS difficulty: medium-advanced
; Description: Throws are not difficult to make, although then can be
;     tedious at times. Throw attempt states have a HitDef of a
;     special format. The key parameters in a throw are p1stateno
;     and p2stateno. If the HitDef successfully connects, then
;     the attacker will change to the state number specified by
;     p1stateno, and the opponent will be change to the state
;     number assigned to p2stateno. The special thing about p2stateno
;     is that the opponent will be temporarily brought into the
;     attacker's state file. In this case, no matter who the
;     opponent is, he will be taken to state 820 of this file (kfm.cns)
;     and remain here until the end of the throw (look at his debug
;     information when he is being thrown; the text changes to yellow
;     to mean that he is in another player's state file).
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800

; Notes: The '-' symbol in the hitflag field means that it only affects
;   players who are not in a hit state. This prevents the player from combo-ing
;   into the throw. The priority should be set to a low number, such as
;   1 or 2, so that the throw does not take precedence over normal attacks.
;   The type of priority must always be set to "Miss" or "Dodge" for throws,
;   otherwise strange behavior can result.
[State 800, 1]
type = HitDef
Trigger1 = Time = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
sprpriority = 1       ;Draw in front of p2
p1facing = ifelse (command = "holdfwd", -1, 1) ;Turn if holding forwards
p2facing = 1          ;Force p2 to face player
p1stateno = 810       ;On success, player changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in player's cns
fall = 1              ;Force p2 into falling down

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Throwing the opponent
; Description: In this state, the player throws the opponent by binding him to
;     various offsets based on his current frame of animation. For
;     example, [State 810, Bind 1] binds the opponent to an offset of
;     28 pixels in front of the player. That puts him around where the hand
;     is at. Is is important to keep the opponent bound using a
;     TargetBind controller at all times, until you let him go. This
;     is especially important if your player has a Clsn2 box that
;     allows him to get hit while throwing someone. Each time a player
;     gets hit, all his bound targets will be set to a fall state. If
;     the opponent is not bound, then he might get stuck in his thrown
;     state when his attacker is knocked out of the throw halfway.
; Notes: There is a TargetLifeAdd controller to decrease the opponent's
;     life, and a TargetState controller to change his state to a
;     falling state when KFM lets go of him.
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
poweradd = 60

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(2) < 0
pos = 28, 0

[State 810, Width 2-11]
type = Width
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(12) < 0
edge = 60,0

[State 810, Bind 2-4]
type = TargetBind
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(5) < 0
pos = 58, 0

[State 810, Bind 5]
type = TargetBind
trigger1 = AnimElemTime(5) >= 0 && AnimElemTime(6) < 0
pos = 47, 0

[State 810, Bind 6]
type = TargetBind
trigger1 = AnimElemTime(6) >= 0 && AnimElemTime(7) < 0
pos = 41, -60

[State 810, Bind 7]
type = TargetBind
trigger1 = AnimElemTime(7) >= 0 && AnimElemTime(8) < 0
pos = 25, -75

[State 810, Bind 8]
type = TargetBind
trigger1 = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
pos = 15, -90

[State 810, Bind 9]
type = TargetBind
trigger1 = AnimElemTime(9) >= 0 && AnimElemTime(10) < 0
pos = -5, -96

[State 810, Bind 10]
type = TargetBind
trigger1 = AnimElemTime(10) >= 0 && AnimElemTime(11) < 0
pos = -14, -90

[State 810, Bind 11]
type = TargetBind
trigger1 = AnimElem = 11
pos = -50, -50

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = AnimElem = 11
value = -78

[State 810, Throw 11]
type = TargetState
trigger1 = AnimElem = 11
value = 821

[State 810, Turn 12]
type = Turn
trigger1 = AnimElem = 12

[State 810, Pos 15]
type = PosAdd
trigger1 = AnimElem = 15
x = -10

[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Opponent Thrown
; (a custom gethit state)
; Description: This is the state that the opponent changes to after being
;     hit by the throw HitDef. The important thing here is to use a
;     ChangeAnim2 controller. The difference between ChangeAnim2 and
;     ChangeAnim is that ChangeAnim2 changes the player's animation to
;     an action in the AIR file of the attacker (in this case, kfm.air),
;     whereas ChangeAnim always changes the player to an action in his
;     own AIR file. Look at Action 820 in kfm.air for some extra
;     comments.
[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

;---------------------------------------------------------------------------
; Opponent thrown into the air
; (a custom gethit state)
; Description: This state has the opponent flying through the air and
;     falling down onto the ground. The SelfState controller sets the
;     opponent back using to his own state file when he his the ground.
;     Controllers 821,2 and 821,3 allow the opponent to recover by
;     hitting his recovery command when he is falling.
[Statedef 821]
type    = A
movetype= H
physics = N
velset = 2.8,-7
poweradd = 40

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
y = .4

[State 821, 2] ; Recover near ground (use ChangeState)
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 821, 3] ; Recover in mid air (use SelfState)
type = SelfState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground
