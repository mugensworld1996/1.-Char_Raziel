bindtime = -1
removetime = -1

sprpriority = 4
scale = 0.20,0.20
ownpal = 1


[State -2, Remove Spectral Stand Blue]
type = RemoveExplod

trigger1 = var(20) = 0
trigger2 = var(21) != 0
trigger3 = Anim != 0
trigger4 = !(PalNo = 1 || PalNo = 3)

ID = 7000

