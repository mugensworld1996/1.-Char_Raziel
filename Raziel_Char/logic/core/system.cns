;==============================================================================
; RAZIEL - GLOBAL SYSTEM
; MUGEN 1.0
;==============================================================================

;------------------------------------------------------------------------------
; VARIABLES
;------------------------------------------------------------------------------
;
; var(20) = Estado de la espada
;   0 = Equipada
;   1 = Clavada
;   2 = Lanzada
;   3 = Caida
;
; var(21) = Reaver activo
;   0 = Spectral
;   1 = Fire
;   2 = Air
;   3 = Water
;   4 = Earth
;   5 = Lightning
;   6 = Light
;   7 = Dark
;   8 = Spirit
;
; var(22) = Carga de la espada
; var(24) = Pose de fin de round: 0 pendiente, 170/180 en curso, -1 terminada
;
;==============================================================================


;==============================================================================
; STATE -2
; Logica global que se ejecuta permanentemente
;==============================================================================

[Statedef -2]

;==============================================================================
; FONDO DE INTRO - ACTION 193
; Solo para el Raziel que esta ejecutando State/Anim 191.
; Funciona tanto en Player 1 como en Player 2.
; Sprite ya reescalado: scale = 1,1 (sin reajustar).
;==============================================================================
[State -2, Mostrar fondo 193 solo en Intro 191]
type = Explod
triggerall = RoundState = 1
triggerall = StateNo = 191
triggerall = Anim = 191
trigger1 = NumExplod(193) = 0
ID = 193
anim = 193
postype = p1
pos = 0,-10
bindtime = -1
removetime = -1
sprpriority = -10
scale = 0.258,0.258
ownpal = 1
ignorehitpause = 1

; Al saltar/terminar la intro, retirar el fondo inmediatamente.
[State -2, Retirar fondo 193 fuera de Intro 191]
type = RemoveExplod
triggerall = NumExplod(193) > 0
trigger1 = RoundState != 1
trigger2 = StateNo != 191
trigger3 = Anim != 191
ID = 193
ignorehitpause = 1


;==============================================================================
; GIRO GLOBAL CON ESPADA
;==============================================================================

[State -2, Sword Turn Override]
type = ChangeAnim

; Solo cuando la espada esta equipada
triggerall = var(20) = 0

; Si MUGEN intenta ejecutar el giro normal
trigger1 = Anim = 5

; Usar nuestro giro con espada
value = 8

ignorehitpause = 1


;------------------------------------------------------------------------------
; INICIALIZACION
;------------------------------------------------------------------------------


; Raziel comienza cada round CON la espada
[State -2, Init Sword]
type = VarSet
trigger1 = RoundState = 0
v = 20
value = 0
ignorehitpause = 1


[State -2, Reiniciar pose de resultado]
type = VarSet
trigger1 = RoundState = 0
v = 24
value = 0
ignorehitpause = 1

; Reaver por defecto: Spectral
; No se mostrara mientras var(20) = 0
[State -2, Init Reaver]
type = VarSet
trigger1 = RoundState = 0
v = 21
value = 0
ignorehitpause = 1


; La espada comienza sin carga
[State -2, Init Sword Charge]
type = VarSet
trigger1 = RoundState = 0
v = 22
value = 0
ignorehitpause = 1


;------------------------------------------------------------------------------
; PROTECCION DE VALORES
;------------------------------------------------------------------------------

[State -2, Reaver Min]
type = VarSet
trigger1 = var(21) < 0
v = 21
value = 0
ignorehitpause = 1


[State -2, Reaver Max]
type = VarSet
trigger1 = var(21) > 8
v = 21
value = 8
ignorehitpause = 1


